from pathlib import Path
import csv
import shutil

import numpy as np
import SimpleITK as sitk


# ============================================================
# 1. INPUT AND OUTPUT PATHS
# ============================================================

# Find "segmentation2" on Desktop or OneDrive Desktop
desktop_candidates = [
    Path.home() / "Desktop",
    Path.home() / "OneDrive" / "Desktop",
]

INPUT_DIR = next(
    (
        desktop / "segmentation2"
        for desktop in desktop_candidates
        if (desktop / "segmentation2").is_dir()
    ),
    None
)

if INPUT_DIR is None:
    searched = "\n".join(
        str(p / "segmentation2")
        for p in desktop_candidates
    )
    raise FileNotFoundError(
        "Could not find segmentation2 folder.\n"
        + searched
    )

OUTPUT_DIR = INPUT_DIR.parent / "segmentation2_processed"
ZIP_BASE_PATH = INPUT_DIR.parent / "segmentation2_processed"

NEW_SPACING = (1.0, 1.0, 1.0)
EMPTY_TOLERANCE = 1e-6
EXPECTED_FILE_COUNT = 49

OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


# ============================================================
# 2. RESAMPLING TO 1 x 1 x 1 mm
# NO HU CLIPPING
# ============================================================

def resample_image(image, new_spacing=(1.0, 1.0, 1.0)):

    old_spacing = image.GetSpacing()
    old_size = image.GetSize()

    # Preserve physical image extent
    new_size = [
        max(
            1,
            int(round(
                (old_size[i] - 1)
                * old_spacing[i]
                / new_spacing[i]
            )) + 1
        )
        for i in range(3)
    ]

    resampler = sitk.ResampleImageFilter()

    resampler.SetOutputSpacing(new_spacing)
    resampler.SetSize(new_size)

    resampler.SetOutputOrigin(image.GetOrigin())
    resampler.SetOutputDirection(image.GetDirection())

    # Same linear interpolation as original code
    resampler.SetInterpolator(sitk.sitkLinear)

    resampler.SetDefaultPixelValue(0)

    return resampler.Execute(image)


# ============================================================
# 3. REMOVE EMPTY SLICES FROM BEGINNING AND END ONLY
# ============================================================

def remove_empty_edge_slices(image, tolerance=1e-6):

    # SimpleITK array order: [z, y, x]
    array = sitk.GetArrayFromImage(image)

    number_of_slices = array.shape[0]

    empty = np.array([
        np.all(np.abs(array[z]) <= tolerance)
        for z in range(number_of_slices)
    ])

    if np.all(empty):
        raise ValueError("The entire image is empty.")

    first_non_empty = int(np.where(~empty)[0][0])
    last_non_empty = int(np.where(~empty)[0][-1])

    removed_from_start = first_non_empty

    removed_from_end = (
        number_of_slices
        - last_non_empty
        - 1
    )

    # RegionOfInterest preserves spatial geometry
    original_size = image.GetSize()

    roi_index = [
        0,
        0,
        first_non_empty
    ]

    roi_size = [
        original_size[0],
        original_size[1],
        last_non_empty - first_non_empty + 1
    ]

    cropped_image = sitk.RegionOfInterest(
        image,
        size=roi_size,
        index=roi_index
    )

    return (
        cropped_image,
        removed_from_start,
        removed_from_end
    )


# ============================================================
# 4. OUTPUT FILENAME
# ============================================================

def get_output_filename(filename):

    if filename.lower().endswith(".nii.gz"):
        base = filename[:-7]

    elif filename.lower().endswith(".nii"):
        base = filename[:-4]

    else:
        base = filename

    return f"processed_{base}.nii.gz"


# ============================================================
# 5. FIND AND PROCESS ALL NIFTI FILES
# ============================================================

files = sorted(
    [
        p for p in INPUT_DIR.iterdir()
        if p.is_file()
        and p.name.lower().endswith((".nii", ".nii.gz"))
    ],
    key=lambda p: p.name.lower()
)

print(f"Input folder: {INPUT_DIR}")
print(f"Output folder: {OUTPUT_DIR}")
print(f"Number of NIfTI files found: {len(files)}")
print("HU clipping: DISABLED")
print("=" * 70)

if not files:
    raise FileNotFoundError(
        f"No NIfTI images found in {INPUT_DIR}"
    )

if len(files) != EXPECTED_FILE_COUNT:
    print(
        f"WARNING: Expected {EXPECTED_FILE_COUNT} "
        f"images, found {len(files)}."
    )
    print("All detected images will be processed.")

report = []

for i, input_path in enumerate(files, start=1):

    filename = input_path.name

    output_filename = get_output_filename(filename)

    output_path = OUTPUT_DIR / output_filename

    print(f"\n[{i}/{len(files)}] Processing: {filename}")

    try:

        # --------------------------------------------
        # LOAD ORIGINAL IMAGE
        # --------------------------------------------

        image = sitk.ReadImage(str(input_path))

        if image.GetDimension() != 3:
            raise ValueError("Expected a 3D NIfTI image.")

        original_spacing = image.GetSpacing()
        original_size = image.GetSize()

        original_array = sitk.GetArrayFromImage(image)

        original_min = float(np.min(original_array))
        original_max = float(np.max(original_array))

        # Convert only the datatype for interpolation.
        # This does NOT clip or truncate the HU range.
        image = sitk.Cast(image, sitk.sitkFloat32)

        # --------------------------------------------
        # STEP 1: RESAMPLE TO 1 x 1 x 1 mm
        # --------------------------------------------

        image = resample_image(
            image,
            NEW_SPACING
        )

        resampled_size = image.GetSize()

        # --------------------------------------------
        # STEP 2: REMOVE EMPTY EDGE SLICES
        # --------------------------------------------

        (
            image,
            removed_start,
            removed_end
        ) = remove_empty_edge_slices(
            image,
            EMPTY_TOLERANCE
        )

        final_size = image.GetSize()

        # --------------------------------------------
        # STEP 3: SAVE IMAGE
        # --------------------------------------------

        sitk.WriteImage(
            image,
            str(output_path),
            True
        )

        # --------------------------------------------
        # STEP 4: RECORD RESULTS
        # --------------------------------------------

        report.append({

            "filename": filename,
            "output_filename": output_filename,

            "original_spacing_x": original_spacing[0],
            "original_spacing_y": original_spacing[1],
            "original_spacing_z": original_spacing[2],

            "original_size_x": original_size[0],
            "original_size_y": original_size[1],
            "original_size_z": original_size[2],

            "original_min_HU": original_min,
            "original_max_HU": original_max,

            "resampled_size_z": resampled_size[2],

            "removed_start_slices": removed_start,
            "removed_end_slices": removed_end,

            "final_size_x": final_size[0],
            "final_size_y": final_size[1],
            "final_size_z": final_size[2],

            "final_spacing": "1x1x1 mm",

            "status": "success"
        })

        print(
            "   Original spacing:",
            tuple(round(x, 3) for x in original_spacing)
        )

        print(
            "   Original HU range:",
            f"{original_min:.1f} to {original_max:.1f}"
        )

        print("   HU clipping: NONE")
        print("   New spacing:", image.GetSpacing())

        print(
            "   Empty slices removed from start:",
            removed_start
        )

        print(
            "   Empty slices removed from end:",
            removed_end
        )

        print("   Final size:", final_size)
        print("   Saved:", output_filename)

    except Exception as e:

        print(f"   ERROR: {e}")

        report.append({
            "filename": filename,
            "status": f"ERROR: {e}"
        })


# ============================================================
# 6. SAVE PROCESSING REPORT AS CSV
# ============================================================

REPORT_PATH = OUTPUT_DIR / "processing_report.csv"

fieldnames = [
    "filename",
    "output_filename",

    "original_spacing_x",
    "original_spacing_y",
    "original_spacing_z",

    "original_size_x",
    "original_size_y",
    "original_size_z",

    "original_min_HU",
    "original_max_HU",

    "resampled_size_z",

    "removed_start_slices",
    "removed_end_slices",

    "final_size_x",
    "final_size_y",
    "final_size_z",

    "final_spacing",
    "status"
]

with REPORT_PATH.open(
    "w",
    newline="",
    encoding="utf-8-sig"
) as csvfile:

    writer = csv.DictWriter(
        csvfile,
        fieldnames=fieldnames
    )

    writer.writeheader()
    writer.writerows(report)


# ============================================================
# 7. CREATE ZIP ARCHIVE
# ============================================================

ZIP_FILE = shutil.make_archive(
    str(ZIP_BASE_PATH),
    "zip",
    str(OUTPUT_DIR)
)


# ============================================================
# 8. FINAL SUMMARY
# ============================================================

success_count = sum(
    row.get("status") == "success"
    for row in report
)

error_count = len(report) - success_count

print("\n" + "=" * 70)
print("PROCESSING COMPLETED")

print(
    f"Successfully processed: "
    f"{success_count}/{len(files)}"
)

print(f"Errors: {error_count}")

print("\nProcessed images folder:")
print(OUTPUT_DIR)

print("\nProcessing report:")
print(REPORT_PATH)

print("\nZIP file:")
print(ZIP_FILE)
