# Helper for filenames
# ============================================================

def get_output_filename(filename):

    if filename.endswith(".nii.gz"):

        base = filename[:-7]

    elif filename.endswith(".nii"):

        base = filename[:-4]

    else:

        base = filename

    return f"processed_{base}.nii.gz"


# ============================================================
# PROCESS ALL PATIENTS
# ============================================================

report = []

files = sorted([
    f for f in os.listdir(INPUT_DIR)
    if f.endswith(".nii") or f.endswith(".nii.gz")
])

print(f"Number of NIfTI images found: {len(files)}")
print("=" * 70)


for i, filename in enumerate(files, start=1):

    input_path = os.path.join(
        INPUT_DIR,
        filename
    )

    output_filename = get_output_filename(filename)

    output_path = os.path.join(
        OUTPUT_DIR,
        output_filename
    )

    print(f"\n[{i}/{len(files)}] Processing: {filename}")

    try:
        # ----------------------------------------------------
        # Load image
        # ----------------------------------------------------

        image = sitk.ReadImage(input_path)

        original_spacing = image.GetSpacing()
        original_size = image.GetSize()

        original_array = sitk.GetArrayFromImage(image)

        original_min = float(np.min(original_array))
        original_max = float(np.max(original_array))


        # ----------------------------------------------------
        # STEP 1
        # HU clipping
        # ----------------------------------------------------

        image = clip_hu(
            image,
            HU_MIN,
            HU_MAX
        )


        # ----------------------------------------------------
        # STEP 2
        # Resample to 1 x 1 x 1 mm^3
        # ----------------------------------------------------

        image = resample_image(
            image,
            NEW_SPACING
        )

        resampled_size = image.GetSize()


        # ----------------------------------------------------
        # STEP 3
        # Remove empty slices from beginning/end
        # ----------------------------------------------------

        (
            image,
            removed_start,
            removed_end
        ) = remove_empty_edge_slices(
            image,
            EMPTY_TOLERANCE
        )


        final_size = image.GetSize()


        # ----------------------------------------------------
        # STEP 4
        # Save final image
        # ----------------------------------------------------

        sitk.WriteImage(
            image,
            output_path,
            True
        )


        # ----------------------------------------------------
        # Report
        # ----------------------------------------------------

        report.append({

            "filename":
                filename,

            "original_spacing_x":
                original_spacing[0],

            "original_spacing_y":
                original_spacing[1],

            "original_spacing_z":
                original_spacing[2],

            "original_size_x":
                original_size[0],

            "original_size_y":
                original_size[1],

            "original_size_z":
                original_size[2],

            "original_min_HU":
                original_min,

            "original_max_HU":
                original_max,

            "resampled_size_z":
                resampled_size[2],

            "removed_start_slices":
                removed_start,

            "removed_end_slices":
                removed_end,

            "final_size_x":
                final_size[0],

            "final_size_y":
                final_size[1],

            "final_size_z":
                final_size[2],

            "final_spacing":
                "1x1x1 mm",

            "status":
                "success"
        })


        print("   Original spacing:",
              tuple(round(x, 3)
                    for x in original_spacing))

        print("   Original HU range:",
              f"{original_min:.1f} to {original_max:.1f}")

        print("   HU clipping:",
              f"{HU_MIN} to {HU_MAX}")

        print("   New spacing:",
              image.GetSpacing())

        print("   Empty slices removed from start:",
              removed_start)

        print("   Empty slices removed from end:",
              removed_end)

        print("   Final size:",
              final_size)

        print("   Saved:",
              output_filename)


    except Exception as e:

        print(f"   ERROR: {e}")

        report.append({
            "filename": filename,
            "status": f"ERROR: {e}"
        })
