# HU CLIPPING
# ============================================================

def clip_hu(image, hu_min=-1000, hu_max=3000):

    # Convert to float32 to preserve negative HU values
    image = sitk.Cast(image, sitk.sitkFloat32)

    array = sitk.GetArrayFromImage(image)

    # Clip HU values
    array = np.clip(array, hu_min, hu_max)

    clipped_image = sitk.GetImageFromArray(array.astype(np.float32))

    # Preserve spatial information
    clipped_image.CopyInformation(image)

    return clipped_image

# RESAMPLING TO 1 x 1 x 1 mm
# ============================================================

def resample_image(image, new_spacing=(1.0, 1.0, 1.0)):

    old_spacing = image.GetSpacing()
    old_size = image.GetSize()

    # Preserve physical extent of the image
    new_size = [
        int(round(
            (old_size[i] - 1) *
            old_spacing[i] /
            new_spacing[i]
        )) + 1
        for i in range(3)
    ]

    resampler = sitk.ResampleImageFilter()

    resampler.SetOutputSpacing(new_spacing)
    resampler.SetSize(new_size)

    resampler.SetOutputOrigin(image.GetOrigin())
    resampler.SetOutputDirection(image.GetDirection())

    # Linear interpolation is appropriate for CT intensity images
    resampler.SetInterpolator(sitk.sitkLinear)

    # Empty/background voxels outside the original field
    resampler.SetDefaultPixelValue(0)

    resampled_image = resampler.Execute(image)

    return resampled_image

# REMOVE EMPTY SLICES FROM BEGINNING AND END ONLY
# ============================================================

def remove_empty_edge_slices(image, tolerance=1e-6):

    # SimpleITK array order:
    # [z, y, x]
    array = sitk.GetArrayFromImage(image)

    number_of_slices = array.shape[0]

    # Determine which slices are completely empty
    empty = np.array([
        np.all(np.abs(array[z]) <= tolerance)
        for z in range(number_of_slices)
    ])

    # If the entire image is empty
    if np.all(empty):
        raise ValueError("The entire image is empty.")

    # Find first non-empty slice
    first_non_empty = np.where(~empty)[0][0]

    # Find last non-empty slice
    last_non_empty = np.where(~empty)[0][-1]

    removed_from_start = first_non_empty

    removed_from_end = (
        number_of_slices -
        last_non_empty -
        1
    )
 # --------------------------------------------------------
    # IMPORTANT:
    # We use RegionOfInterest rather than np.delete.
    #
    # This preserves the NIfTI spatial geometry and correctly
    # updates the image origin after removing leading slices.
    # --------------------------------------------------------

    original_size = image.GetSize()

    roi_index = [
        0,
        0,
        int(first_non_empty)
    ]

    roi_size = [
        original_size[0],
        original_size[1],
        int(last_non_empty - first_non_empty + 1)
    ]

    cropped_image = sitk.RegionOfInterest(
        image,
        size=roi_size,
        index=roi_index
    )

    return (
        cropped_image,
        removed_from_start,
        removed_from_end
    )
